script "ExtraEnhancedCvars" (void) net
{
	SetCvar("ExtraSpheres_CVar",2);
	SetCvar("Crucifix_Spawner_CVar",1);
	SetCvar("MapRadar_Spawner_CVar",2);
	SetCvar("Biosuit_Spawner_CVar",2);
