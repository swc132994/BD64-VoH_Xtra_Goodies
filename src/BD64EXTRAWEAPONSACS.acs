script "ExtraRandomCvars" (void) net
{
	SetCvar("ExtraSpheres_CVar",0);
	SetCvar("Crucifix_Spawner_CVar",0);
	SetCvar("MapRadar_Spawner_CVar",0);
	SetCvar("Biosuit_Spawner_CVar",0);
