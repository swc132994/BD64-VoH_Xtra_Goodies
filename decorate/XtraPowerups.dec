Actor 64BioSuit : CustomInventory
{
Scale 0.82
Inventory.MaxAmount 0
Inventory.PickupMessage "$XT_GOTPWR_BIO"
Tag "$XT_TAGPWR_BIO"
+INVENTORY.ALWAYSPICKUP
+INVENTORY.AUTOACTIVATE
+INVENTORY.NEVERRESPAWN
+COUNTITEM
	States
	{
	Spawn:
		BIOS A 0 NoDelay A_SpawnItemEx("RadSuitRespawnerDM",0,0,0,0,0,0,0,SXF_NOCHECKPOSITION)
	ACSCheck:
		"####" "#" 0 A_JumpIf(CallACS("AltAmmoSpritesACS") == 2,"AltSpawn")
	ShowNormal:
		BIOS A 6 Bright Light("Blursphere")
		BIOS B 5 Light("Blursphere")
		Goto ACSCheck
	AltSpawn:
		BIOS C 32
		Goto ACSCheck
	Pickup:
		TNT1 A 0 A_GiveInventory("BioArmor",1)
		TNT1 A 0 A_GiveInventory("BioSuitFeet",1)
		TNT1 A 0 A_GiveInventory("BioSuitProtector",1)
		Stop
	}
}

