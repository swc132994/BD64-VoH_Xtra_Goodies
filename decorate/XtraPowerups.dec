Actor 64ArsenalSphere : PowerupGiver
{
Scale 0.82
Powerup.Duration -30
Powerup.Type "PowerInfiniteAmmo"
Powerup.Color "EF EA 4A",0.2
Inventory.PickupMessage "$XT_GOTPWR_ARSE"
Inventory.PickupSound "misc/p_pkup"
Tag "$XT_TAGPWR_ARSE"
+INVENTORY.AUTOACTIVATE
+INVENTORY.ALWAYSPICKUP
+COUNTITEM
	States
	{
	Spawn:
		AMSP ABCD 2 bright
		loop
	}
}

Actor PowerQuadDamage64 : PowerDamage
{
Damagefactor "Normal",4
Powerup.Color "FF 62 FF",0.4
Powerup.Duration -60
}

Actor 64Quadsphere : CustomInventory
{
Scale 0.82
Inventory.PickupMessage "$XT_GOTPWR_QUAD"
Inventory.PickupSound "misc/p_pkup"
Tag "$XT_TAGPWR_QUAD"
+INVENTORY.BIGPOWERUP
+INVENTORY.ALWAYSPICKUP
+INVENTORY.NEVERRESPAWN
+COUNTITEM
	States
	{
	Spawn:
		QUAD A 0 NoDelay A_SpawnItemEx("BerserkRespawnerDM",0,0,0,0,0,0,0,SXF_NOCHECKPOSITION)
	Idle:
		QUAD ABCD 6 Bright
		Loop
	Pickup:
		TNT1 A 0 HealThing(100,200) //added healing ability,for balance to the original Berserk kit's sake
		TNT1 A 0 A_GiveInventory("PowerQuadDamage64")
		Stop
	}
}

