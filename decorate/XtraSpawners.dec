//WEAPON REPLACERS
Actor XtraChainsawReplacer Replaces Chainsaw
{
Scale 0.82
	States
	{
	Spawn:
		CSAW A 0
		TNT1 A 0 A_JumpIf(CallACS("ChainsawSpawner") == 1,"SpawnSaw")
		TNT1 A 0 A_JumpIf(CallACS("ChainsawSpawner") == 2,"SpawnAxe")
		TNT1 A 0 A_Jump(128,"SpawnAxe") //50%
		Goto SpawnSaw
	SpawnSaw:
		TNT1 A 1 A_SpawnItemEx("ChainsawSpawner",0,0,0,0,0,0,0,SXF_TRANSFERPOINTERS|SXF_TRANSFERSPECIAL|SXF_CLEARCALLERTID,0,tid)
		Stop
	SpawnAxe:
		TNT1 A 1 A_SpawnItemEx("FireAxeSpawner",0,0,0,0,0,0,0,SXF_TRANSFERPOINTERS|SXF_TRANSFERSPECIAL|SXF_CLEARCALLERTID,0,tid)
		Stop
	}
}

Actor XtraShotgunReplacer Replaces Shotgun
{
Scale 0.87
	States
	{
	Spawn:
		SHOT A 0
		TNT1 A 0 A_JumpIf(CallACS("ShotgunSpawner") == 1,"SpawnShotgun")
		TNT1 A 0 A_JumpIf(CallACS("ShotgunSpawner") == 2,"SpawnRevolver")
		TNT1 A 0 A_JumpIf(CallACS("ShotgunSpawner") == 3,"SpawnSniperRifle")
		TNT1 A 0 A_Jump(64,"SpawnRevolver")    //25%
		TNT1 A 0 A_Jump(64,"SpawnSniperRifle") //25%
		Goto SpawnShotgun
	SpawnShotgun:
		TNT1 A 1 A_SpawnItemEx("Shotgunspawner",0,0,0,0,0,0,0,SXF_TRANSFERPOINTERS|SXF_TRANSFERSPECIAL|SXF_CLEARCALLERTID,0,tid)
		Stop
	SpawnRevolver:
		TNT1 A 1 A_SpawnItemEx("RevolverSpawner",0,0,0,0,0,0,0,SXF_TRANSFERPOINTERS|SXF_TRANSFERSPECIAL|SXF_CLEARCALLERTID,0,tid)
		Stop
	SpawnSniperRifle:
		TNT1 A 1 A_SpawnItemEx("SniperRifleSpawner",0,0,0,0,0,0,0,SXF_TRANSFERPOINTERS|SXF_TRANSFERSPECIAL|SXF_CLEARCALLERTID,0,tid)
		Stop
	}
}

Actor XtraSSGReplacer Replaces SuperShotgun
